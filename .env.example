# Copy to .env or export these variables in your shell.
TALKROBOT_LLM_API_KEY=
# DASHSCOPE_API_KEY can also be used instead of TALKROBOT_LLM_API_KEY.
TALKROBOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TALKROBOT_LLM_MODEL=qwen-flash

TALKROBOT_ASR_MODEL=iic/SenseVoiceSmall
TALKROBOT_ASR_DEVICE=cuda

TALKROBOT_TTS_PROVIDER=easy_tts_server
TALKROBOT_LANGUAGE=zh
TALKROBOT_TTS_VOICE=zf_xiaoyi
TALKROBOT_TTS_SPEED=1.0

TALKROBOT_LISTEN_MODE=push
TALKROBOT_SLIDING_WINDOW_ROUNDS=5
TALKROBOT_EXPRESSION_ENABLED=true
TALKROBOT_FACE_ENABLED=false
